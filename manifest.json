{
  "manifest_version": 3,
  "name": "LinkedIn AI Job Assistant",
  "version": "1.0",
  "description": "Generate tailored resume & cover letter from LinkedIn job postings.",
  "permissions": ["scripting", "activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/jobs/*"],
      "js": ["content.js"]
    }
  ]
}
